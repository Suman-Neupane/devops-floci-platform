# Environment variables & secrets (CRITICAL: Never commit real credentials)
.env
.env.*
*.env
*.pem
*.key
*.crt
*.pfx
*.p12

# Terraform temporary & state files
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
